<Project>

  <!--
    Microsoft .NET Analyzers (Issue #102):
    Enabled explicitly for every project in this repository so the quality gate
    contract does not depend on SDK defaults. Rule severities are pinned in
    .editorconfig; new .csproj files inherit this automatically.
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Architecture attribute contract (Issue #8):
    Consumer projects opt in with <CompileArchitectureAttributes>true</CompileArchitectureAttributes>
    so every assembly carries the same internal PSXRecomp.Architecture.* attribute types,
    matched by fully qualified name by PSXRecomp.Analyzer.
  -->
  <ItemGroup Condition="'$(CompileArchitectureAttributes)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)src/PSXRecomp.Analyzer/Architecture/PSXRecompArchitectureAttributes.cs"
             Link="Architecture/PSXRecompArchitectureAttributes.cs" />
  </ItemGroup>

  <!--
    ArchitectureAnalyzer (AARC) adoption — shadow mode (Refs #293):
    The generic ArchitectureAnalyzer is wired for the same consumer projects that already
    opt in to architectural enforcement via CompileArchitectureAttributes. The architecture
    contract (src/architecture.contract.json, #291) is supplied as an AdditionalFiles item,
    and the analyzer package is added in shadow mode alongside the existing PSXRecomp.Analyzer.
    Shadow mode keeps both analyzers active so PSXR↔AARC parity can be verified before the old
    analyzer is removed in #294. PSXRecompStudio.Tests does not set CompileArchitectureAttributes
    and therefore does not consume the architecture contract, preserving its current build.
  -->
  <ItemGroup Condition="'$(CompileArchitectureAttributes)' == 'true'">
    <PackageReference Include="loach.ArchitectureAnalyzer" Version="0.1.0" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)src/architecture.contract.json" />
  </ItemGroup>

</Project>
