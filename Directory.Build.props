<Project>

  <!--
    Microsoft .NET Analyzers (Issue #102):
    Enabled explicitly for every project in this repository so the quality gate
    contract does not depend on SDK defaults. Rule severities are pinned in
    .editorconfig; new .csproj files inherit this automatically.
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Architecture attribute contract (Issue #8):
    Consumer projects opt in with <CompileArchitectureAttributes>true</CompileArchitectureAttributes>
    so every assembly carries the same internal PSXRecomp.Architecture.* attribute types.
    The marker definitions live consumer-side in src/Architecture/ and are matched by
    fully qualified name by the ArchitectureAnalyzer contract (src/architecture.contract.json).
  -->
  <ItemGroup Condition="'$(CompileArchitectureAttributes)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)src/Architecture/PSXRecompArchitectureAttributes.cs"
             Link="Architecture/PSXRecompArchitectureAttributes.cs" />
  </ItemGroup>

  <!--
    ArchitectureAnalyzer (AARC) adoption (Refs #293/#294):
    The generic ArchitectureAnalyzer NuGet is wired for every consumer project that opts in to
    architectural enforcement via CompileArchitectureAttributes. The architecture contract
    (src/architecture.contract.json, #291) is supplied as an AdditionalFiles item. The old
    built-in PSXRecomp.Analyzer was removed in #294; AARC is now the single enforcement path.
    PSXRecompStudio.Tests does not set CompileArchitectureAttributes and therefore does not
    consume the architecture contract, preserving its current build.
  -->
  <ItemGroup Condition="'$(CompileArchitectureAttributes)' == 'true'">
    <PackageReference Include="loach.ArchitectureAnalyzer" Version="0.1.0" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)src/architecture.contract.json" />
  </ItemGroup>

</Project>
