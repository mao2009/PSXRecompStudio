<Project>

  <!--
    Microsoft .NET Analyzers (Issue #102):
    Enabled explicitly for every project in this repository so the quality gate
    contract does not depend on SDK defaults. Rule severities are pinned in
    .editorconfig; new .csproj files inherit this automatically.
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Architecture attribute contract (Issue #8):
    Consumer projects opt in with <CompileArchitectureAttributes>true</CompileArchitectureAttributes>
    so every assembly carries the same internal PSXRecomp.Architecture.* attribute types.
    The marker definitions live consumer-side in src/Architecture/ and are matched by
    fully qualified name by the ArchitectureAnalyzer contract (src/architecture.contract.json).
  -->
  <ItemGroup Condition="'$(CompileArchitectureAttributes)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)src/Architecture/PSXRecompArchitectureAttributes.cs"
             Link="Architecture/PSXRecompArchitectureAttributes.cs" />
  </ItemGroup>

  <!--
    ArchitectureAnalyzer (AARC) adoption (Refs #293/#294):
    The generic ArchitectureAnalyzer NuGet and the architecture contract
    (src/architecture.contract.json, #291) are wired via EnableArchitectureAnalyzer, which
    defaults to CompileArchitectureAttributes so every existing consumer keeps enforcing without
    change. The two properties diverge for a project that must be visible to the marker types
    compiled into another referenced assembly (via InternalsVisibleTo) instead of compiling its
    own copy (Issue #388): it sets EnableArchitectureAnalyzer=true explicitly while leaving
    CompileArchitectureAttributes unset, keeping enforcement without a second, colliding copy of
    the marker source. The old built-in PSXRecomp.Analyzer was removed in #294; AARC is now the
    single enforcement path. PSXRecompStudio.Tests follows the Issue #388 pattern: it explicitly
    enables ArchitectureAnalyzer while reusing the marker types exposed by PSXRecompStudio rather
    than compiling a second copy of the marker source.
  -->
  <PropertyGroup Condition="'$(EnableArchitectureAnalyzer)' == ''">
    <EnableArchitectureAnalyzer>$(CompileArchitectureAttributes)</EnableArchitectureAnalyzer>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableArchitectureAnalyzer)' == 'true'">
    <PackageReference Include="loach.ArchitectureAnalyzer" Version="0.1.0" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)src/architecture.contract.json" />
  </ItemGroup>

</Project>