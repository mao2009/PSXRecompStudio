<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <CompileArchitectureAttributes>true</CompileArchitectureAttributes>
</PropertyGroup>

  <PropertyGroup>
    <NativeProjectDir>$(MSBuildThisFileDirectory)../PSXRecomp.Native</NativeProjectDir>
    <NativeBuildDir>$(NativeProjectDir)/build</NativeBuildDir>
    <!-- Issue #813: a runtime host publish sets PsxIsolatedNativeBuild=true and its own ArtifactsPath, so each parallel publish
         gets its own native build directory. A shared build directory let two parallel publishes regenerate the same
         build.ninja at once (ninja: failed recompaction). The SDK sets ArtifactsPath for every UseArtifactsOutput build,
         so the explicit opt-in is what selects the isolated directory. -->
    <NativeBuildDir Condition="'$(PsxIsolatedNativeBuild)' == 'true' and '$(ArtifactsPath)' != ''">$(ArtifactsPath)/native-build</NativeBuildDir>
    <NativeLibName Condition="'$(OS)' == 'Windows_NT'">PSXRecomp.Native.dll</NativeLibName>
    <NativeLibName Condition="'$(NativeLibName)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">libPSXRecomp.Native.dylib</NativeLibName>
    <NativeLibName Condition="'$(NativeLibName)' == '' and '$(OS)' != 'Windows_NT'">libPSXRecomp.Native.so</NativeLibName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="loach.PureSharp" Version="0.1.6" PrivateAssets="all" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PSXRecomp.Tests" />
    <InternalsVisibleTo Include="PSXRecomp.Infrastructure" />
    <InternalsVisibleTo Include="psxrecomp" />
    <InternalsVisibleTo Include="PSXRecomp.RuntimeHost" />
  </ItemGroup>

  <!--
    Build the native library and stage it for copy-to-output as a single
    target, in this order, rather than as two targets stitched together with
    BeforeTargets/AfterTargets. Splitting this into a "BuildNative" target and
    a separate follow-up target was observed to race on a clean multi-project
    solution build (Issue #100); tasks within a single Target always execute
    in document order, which removes that ambiguity.

    BeforeTargets="AssignTargetPaths" (not "CoreCompile") is required: the SDK
    computes the copy-to-output-directory manifest from @(None)/@(Content) in
    the "AssignTargetPaths" target, which runs *before* "CoreCompile". A None
    item added only "BeforeTargets=CoreCompile" is added too late for that
    manifest — the item exists (and CoreCompile itself doesn't need it), but
    it silently never gets copied to $(OutDir), with no build error. That
    was the actual root cause of PSXRecomp.Tests' DllNotFoundException on a
    clean Windows build despite a "successful" `dotnet build`.
  -->
  <!--
    Issue #B2 (MAJOR-2): -DCMAKE_SHARED_LINKER_FLAGS_RELEASE=-s strips the Release shared libraries of this native build. The build
    is shared by every consumer of PSXRecomp.Core, so the flag affects symbol stripping for all of them; it changes no code.
    The impact is recorded in the PR (#834) and in docs/runtime/openbios-firmware-backend.md.
  -->
  <Target Name="BuildNative" BeforeTargets="AssignTargetPaths;CoreCompile"
          Condition="'$(BuildingInsideVisualStudio)' != 'true'">
    <Exec Command="cmake -B &quot;$(NativeBuildDir)&quot; -S &quot;$(NativeProjectDir)&quot; -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_SHARED_LINKER_FLAGS_RELEASE=-s"
          IgnoreExitCode="false" />
    <Exec Command="cmake --build &quot;$(NativeBuildDir)&quot;"
          IgnoreExitCode="false" />
    <ItemGroup>
      <None Include="$(NativeBuildDir)/$(NativeLibName)"
            Condition="Exists('$(NativeBuildDir)/$(NativeLibName)')"
            CopyToOutputDirectory="PreserveNewest" Link="$(NativeLibName)" />
    </ItemGroup>
  </Target>
</Project>
