<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <CompileArchitectureAttributes>true</CompileArchitectureAttributes>
</PropertyGroup>

  <PropertyGroup>
    <NativeProjectDir>$(MSBuildThisFileDirectory)../PSXRecomp.Native</NativeProjectDir>
    <NativeBuildDir>$(NativeProjectDir)/build</NativeBuildDir>
    <NativeLibName>libPSXRecomp.Native.so</NativeLibName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PSXRecomp.Analyzer\PSXRecomp.Analyzer.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>


  <Target Name="BuildNative" BeforeTargets="CoreCompile"
          Condition="'$(BuildingInsideVisualStudio)' != 'true'">
    <Exec Command="cmake -B $(NativeBuildDir) -S $(NativeProjectDir) -G Ninja -DCMAKE_BUILD_TYPE=Release"
          IgnoreExitCode="false" />
    <Exec Command="cmake --build $(NativeBuildDir)"
          IgnoreExitCode="false" />
  </Target>

  <Target Name="IncludeNativeLibrary" AfterTargets="BuildNative"
          BeforeTargets="CoreCompile;ResolvePackageAssets">
    <ItemGroup>
      <None Include="$(NativeBuildDir)/$(NativeLibName)"
            Condition="Exists('$(NativeBuildDir)/$(NativeLibName)')"
            CopyToOutputDirectory="PreserveNewest" Link="$(NativeLibName)" />
    </ItemGroup>
  </Target>
</Project>
