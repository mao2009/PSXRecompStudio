{
  "$schema": "batch-config-schema.json",
  "version": "1.0.0",
  "description": "Batch Skill project configuration",
  
  "repository": {
    "default_branch": "main",
    "remote_name": "origin"
  },
  
  "branch": {
    "naming_pattern": "issue/{issue_number}-{short_description}",
    "allowed_types": ["issue", "feature", "bugfix", "hotfix"]
  },
  
  "worktree": {
    "root": "../worktrees",
    "naming_pattern": "{issue_number}-{short_description}"
  },
  
  "environment": {
    "templates": [
      {
        "source": ".env.example",
        "target": ".env",
        "required": false,
        "method": "copy"
      }
    ],
    "config_file": ".batch-env-config.json"
  },
  
  "approval": {
    "require_explicit_approval": true,
    "invalidate_on_rebase": true,
    "invalidate_on_conflict_resolution": true,
    "tracked_fields": [
      "approved_commit_sha",
      "current_commit_sha",
      "main_head_sha"
    ]
  },
  
  "rebase": {
    "mandatory_before_merge": true,
    "always_rebase": true,
    "delegate_conflicts_to_subagent": true
  },
  
  "merge": {
    "require_approval": true,
    "require_rebase": true,
    "require_no_conflicts": true,
    "require_tests": true,
    "require_report": true,
    "strategy": "--no-ff"
  },
  
  "cleanup": {
    "delete_worktree": true,
    "delete_local_branch": true,
    "delete_remote_branch": true,
    "verify_merge_before_cleanup": true
  },
  
  "state": {
    "persistence": "json_file",
    "file_pattern": ".batch-state-{issue_number}.json",
    "fields": [
      "issue_number",
      "pr_number",
      "branch_name",
      "worktree_path",
      "current_state",
      "current_commit_sha",
      "approved_commit_sha",
      "main_head_sha",
      "created_at",
      "updated_at"
    ]
  },
  
  "reports": {
    "implementation_report": {
      "filename": "IMPLEMENTATION_REPORT.md",
      "required_sections": [
        "Summary",
        "Investigation",
        "Design Decision",
        "Changes",
        "Tests",
        "Risks / Limitations",
        "Related Issues",
        "Verification"
      ]
    },
    "conflict_resolution_report": {
      "filename": "CONFLICT_RESOLUTION_REPORT.md",
      "required_sections": [
        "Conflict Resolution",
        "Cause",
        "Resolution",
        "Verification"
      ]
    }
  },
  
  "external_tools": {
    "git": {
      "command": "git",
      "required": true
    },
    "github_cli": {
      "command": "gh",
      "required": true
    }
  }
}
