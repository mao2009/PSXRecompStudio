{
  "$schema": "batch-config-schema.json",
  "version": "1.0.0",
  "description": "Batch Orchestrator configuration for parallel Issue execution",

  "repository": {
    "default_branch": "main",
    "remote_name": "origin"
  },

  "concurrency": {
    "max_parallel_subagents": 3,
    "configurable": true
  },

  "retry": {
    "max_retries": 3,
    "backoff_base_seconds": 5,
    "backoff_max_seconds": 120,
    "retryable_errors": ["api_error", "timeout", "connection_failure", "transient"],
    "non_retryable_errors": ["code_error", "test_failure", "architecture_violation", "dependency_conflict"]
  },

  "worktree": {
    "root": "../worktrees",
    "naming_pattern": "{issue_number}-{short_description}",
    "force_remove_on_cleanup": true
  },

  "branch": {
    "naming_pattern": "issue/{issue_number}-{short_description}",
    "allowed_types": ["issue", "feature", "bugfix", "hotfix"]
  },

  "environment": {
    "init_files": [".env"],
    "forbid_secrets_in_pr": true,
    "forbid_credential_logging": true
  },

  "merge": {
    "delegate_to_merge_skill": true,
    "merge_skill_path": "../merge",
    "serial_merge": true,
    "forbid_admin_bypass": true,
    "forbid_force_push": true,
    "forbid_direct_push": true,
    "require_rebase_before_merge": true
  },

  "approval": {
    "per_issue_independent": true,
    "sha_bound": true,
    "invalidate_on_rebase": true,
    "invalidate_on_commit_change": true,
    "invalidate_on_force_push": true,
    "invalidate_on_head_change": true
  },

  "subagent": {
    "never_substitute_implementation": true,
    "require_structured_report": true,
    "required_report_fields": [
      "InvestigationSummary",
      "ImplementationSummary",
      "DesignDecision",
      "ChangedFiles",
      "TestResults",
      "PrNumber",
      "CommitSha"
    ]
  },

  "state": {
    "persistence": "json_file",
    "batch_file_pattern": ".batch-state-{batch_id}.json",
    "issues_file_pattern": ".batch-issues-{batch_id}.json",
    "resume_enabled": true,
    "sync_with_github_on_resume": true
  },

  "cleanup": {
    "delete_worktree": true,
    "delete_local_branch": true,
    "delete_remote_branch": true,
    "prune_stale_references": true
  },

  "external_tools": {
    "git": {
      "command": "git",
      "required": true
    },
    "github_cli": {
      "command": "gh",
      "required": true
    },
    "powershell": {
      "command": "pwsh",
      "required": true
    }
  }
}
