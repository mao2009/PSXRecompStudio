root = true

[*.cs]

# PureSharp 0.1.6 diagnostics configuration
# Essential rules for purity and immutability are enforced as errors (quality gate)
# Naming convention suggestions are warnings for gradual improvement

# Referential Transparency (RT) - core purity rules
dotnet_diagnostic.RT0001.severity = error
dotnet_diagnostic.RT0002.severity = error
dotnet_diagnostic.RT0003.severity = error

# Local Variable Purity (LVP) - immutability enforcement
dotnet_diagnostic.LVP0001.severity = error
dotnet_diagnostic.LVP0002.severity = error

# Naming convention suggestion - gradual improvement
# LVP0003 recommends underscore prefix for effectively immutable variables
# Set to warning to guide development without breaking builds
dotnet_diagnostic.LVP0003.severity = warning

# FluentIf (FIF) - control flow safety
dotnet_diagnostic.FIF0001.severity = error

# Microsoft .NET Analyzers (CA) - standard .NET quality gate (Issue #102)
# General .NET API usage / reliability rules delegated to official analyzers,
# complementing PureSharp (project-specific purity) and PSXR (architecture).
# Severity pinned explicitly per the #105 gate-contract convention.
dotnet_diagnostic.CA2201.severity = error
dotnet_diagnostic.CA2200.severity = error
dotnet_diagnostic.CA1069.severity = error
dotnet_diagnostic.CA1816.severity = error

# PSXRecomp Architecture Analyzer (PSXR) - architecture quality gate
# Severity is pinned explicitly so the gate contract does not rely on
# descriptor defaults and cannot be weakened silently. See docs/architecture-matrix.md.
# Verified end-to-end (build + CI failure on violation) in Issue #105 / PR #107.
dotnet_diagnostic.PSXR001.severity = error
dotnet_diagnostic.PSXR002.severity = error
dotnet_diagnostic.PSXR003.severity = error
dotnet_diagnostic.PSXR004.severity = error
dotnet_diagnostic.PSXR005.severity = error
dotnet_diagnostic.PSXR006.severity = error
